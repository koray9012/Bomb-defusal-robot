#include <Arduino.h>
#include <WiFi.h>
#include <esp_now.h>
#include <WebServer.h>
#include <ESP32Servo.h>
#include "soc/soc.h"
#include "soc/rtc_cntl_reg.h"

// --- Credentials ---
const char* ssid = "Defusal-Rover";
const char* password = "12345678";

WebServer server(80);

// --- Pin Definitions ---
const int IN1 = 16;
const int IN2 = 27;
const int IN3 = 26;
const int IN4 = 25;
const int ENA = 13;
const int ENB = 21;

const int PIN_SPIN = 4;
const int PIN_LIFTER = 22;
const int PIN_GRIPPER = 32;

Servo spinServo;
Servo lifterServo;
Servo gripperServo;

// PWM Channels for Motors (Updated for modern ESP32 Core compatibility)
const int pwmChannelA = 0;
const int pwmChannelB = 1;

// State Variables
bool armMode = false;
bool gripperOpen = false;

// Current Servo Positions (defaults)
int currentSpin = 90;
int currentLifter = 0;
int currentGripper = 0;

// --- ESP-NOW STRUCT & GLOBALS ---
typedef struct struct_message {
  int speedLeft;     
  int speedRight;    
  bool lmb;          
  bool rmb;
  bool mmb;
  bool isFrozen;     
} struct_message;

struct_message gloveData;

struct IdentityMessage {
  char name[32];
};
IdentityMessage robotIdentity;

unsigned long lastEspNowPacketTime = 0;
uint8_t controllerMac[6];
bool controllerKnown = false;
const char* ROBOT_NAME = "Defusal-Rover-Unit";

