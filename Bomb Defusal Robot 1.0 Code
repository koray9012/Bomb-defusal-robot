// --- Motor & Action Core Function ---
void executeAction(String action) {
  if (!armMode) {
    // --- DRIVING MODE ---
    if (action == "up") {
      digitalWrite(IN1, HIGH); digitalWrite(IN2, LOW);
      digitalWrite(IN3, HIGH); digitalWrite(IN4, LOW);
      ledcWrite(pwmChannelA, 200); ledcWrite(pwmChannelB, 200);
    } else if (action == "down") {
      digitalWrite(IN1, LOW); digitalWrite(IN2, HIGH);
      digitalWrite(IN3, LOW); digitalWrite(IN4, HIGH);
      ledcWrite(pwmChannelA, 200); ledcWrite(pwmChannelB, 200);
    } else if (action == "left") {
      digitalWrite(IN1, LOW); digitalWrite(IN2, HIGH);
      digitalWrite(IN3, HIGH); digitalWrite(IN4, LOW);
      ledcWrite(pwmChannelA, 180); ledcWrite(pwmChannelB, 180);
    } else if (action == "right") {
      digitalWrite(IN1, HIGH); digitalWrite(IN2, LOW);
      digitalWrite(IN3, LOW); digitalWrite(IN4, HIGH);
      ledcWrite(pwmChannelA, 180); ledcWrite(pwmChannelB, 180);
    } else if (action == "stop") {
      digitalWrite(IN1, LOW); digitalWrite(IN2, LOW);
      digitalWrite(IN3, LOW); digitalWrite(IN4, LOW);
      ledcWrite(pwmChannelA, 0); ledcWrite(pwmChannelB, 0);
    }
  } else {
    // --- ARM CONTROL MODE ---
    digitalWrite(IN1, LOW); digitalWrite(IN2, LOW);
    digitalWrite(IN3, LOW); digitalWrite(IN4, LOW);
    ledcWrite(pwmChannelA, 0); ledcWrite(pwmChannelB, 0);

    if (action == "left") {
      currentSpin = constrain(currentSpin - 10, 0, 180);
      spinServo.write(currentSpin);
    } else if (action == "right") {
      currentSpin = constrain(currentSpin + 10, 0, 180);
      spinServo.write(currentSpin);
    } else if (action == "up") {
      currentLifter = constrain(currentLifter + 10, 0, 180);
      lifterServo.write(currentLifter);
    } else if (action == "down") {
      currentLifter = constrain(currentLifter - 10, 0, 180);
      lifterServo.write(currentLifter);
    }
  }
}

// --- ESP-NOW Receive Callback (2-Way Link) ---
void OnDataRecv(const esp_now_recv_info_t *recv_info, const uint8_t *incomingData, int len) {
  if (len == sizeof(struct_message)) {
    memcpy(&gloveData, incomingData, sizeof(gloveData));
    lastEspNowPacketTime = millis();

    // Map incoming controller data to driving actions
    if (gloveData.isFrozen) {
      executeAction("stop");
    } else if (gloveData.speedLeft > 50 && gloveData.speedRight > 50) {
      executeAction("up");
    } else if (gloveData.speedLeft < -50 && gloveData.speedRight < -50) {
      executeAction("down");
    } else if (gloveData.speedLeft < -20 && gloveData.speedRight > 20) {
      executeAction("left");
    } else if (gloveData.speedLeft > 20 && gloveData.speedRight < -20) {
      executeAction("right");
    } else {
      executeAction("stop");
    }

    // Register peer and send telemetry acknowledgment back (2-way handshake)
    if (!controllerKnown && recv_info->src_addr != NULL) {
      memcpy(controllerMac, recv_info->src_addr, 6);
      esp_now_peer_info_t peerInfo = {};
      memcpy(peerInfo.peer_addr, controllerMac, 6);
      peerInfo.channel = 0;
      peerInfo.encrypt = false;
      if (esp_now_add_peer(&peerInfo) == ESP_OK) {
        controllerKnown = true;
      }
    }

    if (controllerKnown) {
      strncpy(robotIdentity.name, ROBOT_NAME, sizeof(robotIdentity.name));
      esp_now_send(controllerMac, (uint8_t *)&robotIdentity, sizeof(robotIdentity));
    }
  }
}

// --- Web Server Handlers ---
void handleRoot() {
  server.send(200, "text/html", MAIN_PAGE);
}

void handleMode() {
  if (server.hasArg("arm")) {
    armMode = server.arg("arm").toInt() == 1;
  }
  server.send(200, "text/plain", "OK");
}

void handleGripper() {
  gripperOpen = !gripperOpen;
  currentGripper = gripperOpen ? 90 : 0; 
  gripperServo.write(currentGripper);
  server.send(200, "text/plain", "OK");
}

void handleCommand() {
  if (!server.hasArg("action")) {
    server.send(200, "text/plain", "No action");
    return;
  }
  executeAction(server.arg("action"));
  server.send(200, "text/plain", "ACK");
}

void setup() {
  WRITE_PERI_REG(RTC_CNTL_BROWN_OUT_REG, 0);

  pinMode(IN1, OUTPUT);
  pinMode(IN2, OUTPUT);
  pinMode(IN3, OUTPUT);
  pinMode(IN4, OUTPUT);

  // Setup PWM channels
  ledcAttach(ENA, 30000, 8);
  ledcAttach(ENB, 30000, 8);

  ESP32PWM::allocateTimer(0);
  ESP32PWM::allocateTimer(1);
  spinServo.setPeriodHertz(50);
  lifterServo.setPeriodHertz(50);
  gripperServo.setPeriodHertz(50);

  spinServo.attach(PIN_SPIN, 500, 2400);
  lifterServo.attach(PIN_LIFTER, 500, 2400);
  gripperServo.attach(PIN_GRIPPER, 500, 2400);

  // Default positions
  spinServo.write(currentSpin);
  lifterServo.write(currentLifter);
  gripperServo.write(currentGripper);

  // Start Wi-Fi AP & ESP-NOW in Dual Mode (WIFI_AP_STA)
  WiFi.mode(WIFI_AP_STA);
  WiFi.softAP(ssid, password);

  if (esp_now_init() == ESP_OK) {
    esp_now_register_recv_cb(OnDataRecv);
  }

  // Setup Web Server Routes
  server.on("/", handleRoot);
  server.on("/cmd", handleCommand);
  server.on("/mode", handleMode);
  server.on("/gripper", handleGripper);
  server.begin();
}

void loop() {
  server.handleClient();

  // If ESP-NOW signal is lost for more than 500ms, halt motion for safety
  if (millis() - lastEspNowPacketTime > 500 && lastEspNowPacketTime != 0) {
    // Only stop if web browser isn't actively overriding
    // (Optional safety failsafe)
  }
}
